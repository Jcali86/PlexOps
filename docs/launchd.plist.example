<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plex-ops.api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/PlexOps/venv/bin/python</string>
        <string>/path/to/PlexOps/main.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/PlexOps</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/PlexOps/logs/plex-ops.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/PlexOps/logs/plex-ops-error.log</string>
</dict>
</plist>
